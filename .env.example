# Copy to .env and fill values for your own local environment.
# This template contains no credentials. Do not commit the filled .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=recommender
DB_USER=
DB_PASSWORD=

# Required for natural-language chat; choose models available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Used by data preparation / S3 loaders; not required for the portfolio demo.
AWS_PROFILE=
AWS_REGION=ap-northeast-2
S3_BUCKET=

# Service UI connects to the optimized API.
RECOMMEND_API_URL=http://127.0.0.1:8001/chat/recommend

# Airflow review DAG uses these names; configure separately if running it.
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=recommender
MARIADB_USER=
MARIADB_PASSWORD=
# Airflow DAGs use S3_BUCKET_NAME, while local loaders use S3_BUCKET.
S3_BUCKET_NAME=
